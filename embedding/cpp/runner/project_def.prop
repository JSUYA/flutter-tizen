APPNAME = runner
type = app
profile = common-6.0

USER_SRCS = runner.cc ../*.cc
USER_CPP_DEFS = TIZEN_DEPRECATION DEPRECATION_WARNING
USER_INC_DIRS = ../include
USER_LFLAGS = -Wl,-E

# The DALi application model (dali-application) is loaded at runtime by
# dali_application_abi.cc until its API becomes public. Link it directly then:
# USER_LIBS = dali-application dali2-adaptor dali2-core
